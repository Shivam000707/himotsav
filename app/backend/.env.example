# Copy this file to app/backend/.env and fill in your key. .env is git-ignored: never commit it.

# Free developer key from https://build.nvidia.com (open any model, click "Get API Key").
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Model ids. NVIDIA retires hosted models often (HTTP 410): run scripts/spike_parse.py to check them.
# Reads a report photo into text lines with positions (a vision-language model; NVIDIA retired Nemotron Parse).
NVIDIA_PARSE_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
# Turns the text lines into structured test values and medicines.
NVIDIA_TEXT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# Fallback that reads the page image straight into structured values (for example handwriting).
NVIDIA_VISION_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

# Second reader: re-reads each value's line from a zoomed crop with a different model, and marks the value
# unsure if the numbers disagree. Leave empty to switch the check off.
NVIDIA_VERIFY_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# Optional voice input. Copy the function id from the ASR model's API page on build.nvidia.com
# (for Hindi: Parakeet 1.1B RNNT multilingual). Leave empty to use the browser's speech recognition.
NVIDIA_ASR_FUNCTION_ID=
NVIDIA_ASR_LANG=hi-IN

# "Today" for the rules. 2026-10-14 matches the simulation and the demo script.
# Remove the line to use the real date.
DEMO_TODAY=2026-10-14
